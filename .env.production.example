# Exemplo de produção ClinMax API (VPS). Sem senhas reais — copie e preencha.
# Postgres: container clinmax_postgres em 127.0.0.1:5435 (ver deploy/docker-compose.prod.yml).
# Preferir valores SEM aspas: o PM2 carrega via env_file e aspas podem virar parte da senha.

DATABASE_URL=postgresql://clinmax:CHANGE_ME@127.0.0.1:5435/clinmax?schema=public
POSTGRES_USER=clinmax
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=clinmax

PORT=3550
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRES=7d
NODE_ENV=production

FRONTEND_URL=https://app.clinmax.com.br
PUBLIC_APP_URL=https://api.clinmax.com.br
