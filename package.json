{
  "name": "clinicare-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "postinstall": "prisma generate",
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json && node scripts/assert-dist-no-alias.cjs",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "mail:test": "node --env-file=.env --import tsx scripts/test-mail.ts",
    "mail:invite": "node --env-file=.env --import tsx scripts/test-invite-mail.ts",
    "mail:icons": "node --import tsx scripts/build-email-icons.ts",
    "mail:hero": "node --import tsx scripts/build-email-hero.ts",
    "test": "node --import tsx --test src/lib/plan-catalog.test.ts src/domain/state-machines/state-machines.test.ts src/domain/audit/audit.test.ts src/domain/signature/signature-auth.test.ts src/domain/ops.test.ts scripts/validate-pm2-registration.test.cjs",
    "db:setup": "prisma db push && npm run db:seed",
    "db:studio": "prisma studio",
    "import:cid": "tsx src/scripts/import-cid.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.7.0",
    "@whiskeysockets/baileys": "^7.0.0-rc12",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.2.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.10",
    "pino": "^10.3.1",
    "puppeteer": "^25.0.4",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.17.9",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.7.0",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
